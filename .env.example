# Vorlage für die Umgebungsvariablen der Anfrage-Funktion (api/anfrage.js → lib/anfrage.mjs).
# Echte Werte gehören in Vercel → Project → Settings → Environment Variables,
# lokal in eine Datei .env (steht in .gitignore). Diese Datei enthält keine Geheimnisse.

# API-Schlüssel von Resend. Absender-Domain vistaflows.com muss dort verifiziert sein (DNS-Einträge).
RESEND_API_KEY=

# Absender der E-Mails (Adresse auf der verifizierten Domain)
MAIL_FROM="VistaFlows <anfrage@vistaflows.com>"

# Empfänger der Benachrichtigung bei neuen Anfragen
MAIL_TO=info@vistaflows.com

# "1" = nichts versenden, nur protokollieren (lokal und für Tests). In Produktion leer lassen.
ANFRAGE_DRY_RUN=
