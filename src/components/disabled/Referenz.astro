---
// NICHT EINGEBUNDEN – bewusst deaktiviert (Stand Oktober 2026: noch keine Kundenprojekte).
// Aktivieren, sobald ein echtes Projekt mit schriftlicher Freigabe des Kunden vorliegt:
//   1. Daten in src/data/referenzen.ts anlegen (Datei neu erstellen, Struktur siehe Props).
//   2. Auf der Startseite nach dem Abschnitt „Leistungen“ und auf der passenden
//      Leistungsseite vor den Paketen einbinden: <Referenz projekt={...} />
//   3. Nur belegbare Zahlen (z. B. aus Search Console oder Formular-Eingängen) verwenden.
//   4. Zitate nur wörtlich und mit Freigabe (Name abgekürzt, Ort, Leistung).
// Niemals Projekte, Zahlen oder Zitate erfinden.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  projekt: {
    kunde: string;
    ort: string;
    branche: string;
    leistung: string;
    ausgangslage: string;
    vorgehen: string;
    ergebnis: string;
    /** Belegbare Kennzahl mit Quelle, z. B. „+38 % Anfragen (Formular-Eingänge, 3 Monate)“ */
    kennzahl?: { wert: string; quelle: string };
    zitat?: { text: string; person: string; freigabeDatum: string };
    bild?: { src: ImageMetadata; alt: string };
    url?: string;
  };
}

const { projekt: p } = Astro.props;
---

<article class="split split--top referenz">
  {
    p.bild && (
      <div class="founder__img">
        <Picture src={p.bild.src} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 980px) 100vw, 560px" alt={p.bild.alt} loading="lazy" />
      </div>
    )
  }
  <div>
    <p class="label">{p.branche} · {p.ort}</p>
    <h3 class="mt-s">{p.kunde}: {p.leistung}</h3>
    <dl class="principles">
      <div><dt>Ausgangslage</dt><dd>{p.ausgangslage}</dd></div>
      <div><dt>Vorgehen</dt><dd>{p.vorgehen}</dd></div>
      <div><dt>Ergebnis</dt><dd>{p.ergebnis}</dd></div>
      {p.kennzahl && <div><dt>{p.kennzahl.wert}</dt><dd>Quelle: {p.kennzahl.quelle}</dd></div>}
    </dl>
    {
      p.zitat && (
        <blockquote class="prose">
          <p>„{p.zitat.text}“</p>
          <footer>{p.zitat.person}</footer>
        </blockquote>
      )
    }
    {p.url && <a class="link-arrow" href={p.url} target="_blank" rel="noopener noreferrer">Website ansehen</a>}
  </div>
</article>
