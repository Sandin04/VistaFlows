export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { name, size = "md", class: className } = Astro.props;
const px = size === "sm" ? 17 : size === "lg" ? 28 : 22;
---

<svg
  class:list={["ico", `ico-${size}`, className]}
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
