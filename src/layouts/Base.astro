---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { site } from "../data/site";
import { graph, breadcrumbs, type Crumb } from "../data/schema";

interface Props {
  /** Vollständiger Seitentitel, ca. 50–60 Zeichen */
  title: string;
  /** Meta-Description, ca. 140–160 Zeichen */
  description: string;
  /** Pfad ohne Domain und ohne abschließenden Slash, z. B. "/preise" */
  path: string;
  og?: string;
  ogAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  schema?: object[];
  crumbs?: Crumb[];
  stickyCta?: boolean;
  published?: string;
  updated?: string;
}

const {
  title,
  description,
  path,
  og = "/og/start.png",
  ogAlt = "VistaFlows – Websites, SEO & GEO und 360°-Rundgänge aus Bottrop",
  ogType = "website",
  noindex = false,
  schema = [],
  crumbs,
  stickyCta = true,
  published,
  updated,
} = Astro.props;

const canonical = `${site.url}${path === "/" ? "/" : path}`;
const ogUrl = `${site.url}${og}`;
const nodes = crumbs && crumbs.length > 1 ? [breadcrumbs(crumbs), ...schema] : schema;
const jsonLd = graph(nodes);
// Vercel Web Analytics gibt es nur auf Vercel. Lokal wird das Skript weggelassen.
const onVercel = process.env.VERCEL === "1";
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content={site.owner} />
    <meta name="theme-color" content="#0a0c11" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <Font cssVariable="--font-inter" preload />

    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {onVercel && <script is:inline defer src="/_vercel/insights/script.js" />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header path={path} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyCta />}
      <script>
      // Messkonzept (docs/03-messkonzept.md): Klicks auf Telefon- und E-Mail-Links als Ereignis
      // für Vercel Web Analytics. Ohne Analytics-Skript (lokal, Vorschau) passiert nichts.
      // Eigene Ereignisse wertet Vercel nur im Pro-Tarif aus.
      document.addEventListener("click", (e) => {
        const link = (e.target as Element | null)?.closest?.('a[href^="tel:"], a[href^="mailto:"]');
        if (!link) return;
        const w = window as unknown as { va?: (type: string, data: object) => void };
        w.va?.("event", { name: link.getAttribute("href")?.startsWith("tel:") ? "Telefon-Klick" : "E-Mail-Klick" });
      });
    </script>
  </body>
</html>
